# ── Database (required) ─────────────────────────────────────────────────────
# Local development:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/adwuma360?schema=public"
# Serverless hosting (Vercel etc.): use your provider's POOLED connection string
# and require TLS, otherwise concurrent requests will exhaust Postgres connections.
#   postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# Do NOT add ?connection_limit= or ?pgbouncer= — those are Prisma query-engine
# flags and are ignored by the pg driver adapter this app uses. Pool size is a
# driver option instead; override it with DATABASE_POOL_MAX below.

# Connections per instance. Defaults to 1 on Vercel and 10 elsewhere.
# DATABASE_POOL_MAX="1"

# ── Auth (required) ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"          # set to your deployment origin in production
AUTH_TRUST_HOST=true

# Optional: Google sign-in. The button only appears when BOTH are set, so
# leaving these blank simply omits it rather than showing a control that fails.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ── App (required) ──────────────────────────────────────────────────────────
# Used for metadata and for the links in verification / password-reset emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Branding (all optional — defaults live in src/lib/config/brand.ts) ───────
NEXT_PUBLIC_BRAND_NAME="Adwuma360"
NEXT_PUBLIC_BRAND_SHORT_NAME="Adwuma360"
# The two brand hues are sampled from the logomark and live in
# src/lib/config/brand.ts. Set these only to re-theme a white-label build.
# NEXT_PUBLIC_BRAND_PRIMARY="#2563eb"
# NEXT_PUBLIC_BRAND_SECONDARY="#0c3060"
NEXT_PUBLIC_COUNTRY="Ghana"
NEXT_PUBLIC_COUNTRY_CODE="GH"
NEXT_PUBLIC_DEFAULT_TAX_RATE="10"
# Currency is read by every money formatter in the app. Changing it relabels
# existing figures rather than converting them, so only set it on a workspace
# whose records are already in that currency.
NEXT_PUBLIC_CURRENCY="GHS"
NEXT_PUBLIC_CURRENCY_SYMBOL="GH₵"

# ── Email ───────────────────────────────────────────────────────────────────
# "console" (the default) sends nothing and prints the message, including the
# confirmation code and any link, to the server log. Every flow is testable
# that way: the confirmation screen says where the code came out rather than
# telling people to check an inbox that will stay empty.
# There is no package to install — Resend is called over its HTTPS API.
# See docs/EMAIL.md, and `npm run email:preview` to read the templates.
EMAIL_TRANSPORT="console"

# "resend" delivers over HTTPS, which is what a serverless host can do —
# outbound SMTP ports are usually closed, so an SMTP client would just hang.
# EMAIL_TRANSPORT="resend"
# RESEND_API_KEY="re_..."

# Must be an address on a domain verified with the provider. Until you verify
# one, Resend accepts onboarding@resend.dev and will only deliver to the email
# address that owns the Resend account.
EMAIL_FROM="Adwuma360 <support@adwuma360.online>"

# ── Operating Adwuma360 itself ──────────────────────────────────────────────
# Addresses listed here can open the operator console at /admin, whatever the
# database says. It is the bootstrap: a fresh deployment has no operator, and
# something has to be able to create the first one. It is also the way back in
# if the last operator flag is revoked by mistake.
#
# Everyone else is granted from inside the console, which sets a flag on the
# account. Neither route grants anything inside a customer's workspace.
#
# Comma separated. Leave empty in an environment nobody should be operating
# the platform from.
PLATFORM_ADMIN_EMAILS=""
